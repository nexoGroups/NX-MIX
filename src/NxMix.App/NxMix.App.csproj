<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>NX-MIX</AssemblyName>
    <RootNamespace>NxMix.App</RootNamespace>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NxMix.Engine\NxMix.Engine.csproj" />
    <ProjectReference Include="..\NxMix.Audio\NxMix.Audio.csproj" />
    <ProjectReference Include="..\NxMix.Ipc\NxMix.Ipc.csproj" />
    <ProjectReference Include="..\NxMix.Daemon\NxMix.Daemon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(NativeDriverMsiSha256)' != ''">
    <AssemblyMetadata Include="NxMixNativeDriverMsiSha256" Value="$(NativeDriverMsiSha256)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fonts\Inter-*.ttf;Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Licenses\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE.txt;..\..\THIRD-PARTY.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyDaemonExecutable" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup>
      <DaemonArtifacts Include="..\NxMix.Daemon\bin\$(Configuration)\$(TargetFramework)\NxMix.Daemon.exe" />
      <DaemonArtifacts Include="..\NxMix.Daemon\bin\$(Configuration)\$(TargetFramework)\NxMix.Daemon.runtimeconfig.json" />
      <DaemonArtifacts Include="..\NxMix.Daemon\bin\$(Configuration)\$(TargetFramework)\NxMix.Daemon.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DaemonArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>
</Project>
